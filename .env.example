# 本地作答模型；填写 OpenAI 兼容接口。与 AML 平台评测凭证无关。
ANSWER_API_BASE=
ANSWER_API_KEY=
ANSWER_MODEL=
ANSWER_REASONING_EFFORT=low

# 本地评分模型（开放题通常需要）；可与作答模型使用不同服务。
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_VERSION=
JUDGE_REASONING_EFFORT=low

# 记忆整理与查找模型；独立配置，不自动借用作答或评分模型。
# API_BASE 填写到 /v1 等服务根路径，程序追加 /chat/completions。
MEMORY_API_BASE=
MEMORY_API_KEY=
MEMORY_MODEL=
# 可选备用渠道：数字后缀从 2 开始，可继续添加 _3、_4；每个启用渠道的三项核心配置都必填。
# failover（默认）：当前渠道失败后切换；round_robin：长运行入口跨请求轮流选择起始渠道。
# ANSWER_*、JUDGE_* 也使用同样的渠道和策略配置。
# MEMORY_CHANNEL_STRATEGY=round_robin
# 选填：所有渠道都达到上限后仍继续使用的渠道编号；该渠道会越过本地上限并继续记账。
# MEMORY_EXHAUSTED_FALLBACK=1
# MEMORY_API_BASE_2=
# MEMORY_API_KEY_2=
# MEMORY_MODEL_2=
# MEMORY_REASONING_EFFORT_2=

# 可选来源名称，只用于用量报告；ANSWER/JUDGE 与数字后缀渠道同样支持。
# 同一服务地址和同一 key 在写入、答题、评分之间合并计数；换 key 后另记。
# MEMORY_KEY_SOURCE=OpenAI 账户 A
# MEMORY_KEY_SOURCE_2=另一来源
# 默认累计保存到项目 state/model-usage.sqlite；所有同时运行的任务须使用同一文件。
# MODEL_USAGE_DB=/absolute/path/model-usage.sqlite
# 运行中查看、调整优先级和设置美元/token 上限：python -m text_memory channels --help
# 详细说明见 docs/model-channels.md。默认不设置任何上限。

# 向量模型用于事实排序、会话补全和关系候选；正式入口必须配置。
# 向量接口不使用上述生成模型备用渠道，避免混用不同向量空间。
# MEMORY_EMBED_PYTHON 指向已安装 sentence-transformers 的 Python；只读本地缓存，不下载。
MEMORY_EMBED_PYTHON=
MEMORY_EMBED_MODEL=
MEMORY_EMBED_REVISION=
# 会话补全所用配置；整句事实排序不设分数门槛。当前 BGE 配置为 0.62。
# 固定模型 BAAI/bge-base-en-v1.5，revision a5beb1e3e68b9ab74eb54cfd186867f64f240e1a。
# 如使用 HTTP 向量，填写 API_BASE/API_KEY，清空 MEMORY_EMBED_PYTHON。
# MEMORY_EMBED_API_BASE=
# MEMORY_EMBED_API_KEY=
# MEMORY_EMBED_BATCH_SIZE=10
MEMORY_EMBED_FLOOR=

# 仅启动 HTTP 服务时需要；本地命令行读写不需要。
MEMORY_SERVICE_TOKEN=
